# Copy this file to .env.local and fill in real values.
# Get DATABASE_URL from your Neon project dashboard (Session 0 setup).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session 2 — Better Auth
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials (github.com/settings/developers)
# Callback URL to register there: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth Client (console.cloud.google.com -> APIs & Services -> Credentials)
# Redirect URI to register there: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
